# Birthday Bot settings.
# Copy this file to ".env" (same folder) and fill in the values.
# NEVER commit or share your .env — it contains your bot's password (token).

# ---------------------------------------------------------------- required --

# The token @BotFather gives you when you create your bot.
# It looks like: 1234567890:AAAbbbCCC... (a number, a colon, then ~35 letters)
BIRTHDAY_BOT_TOKEN=paste-your-bot-token-here

# Your personal Telegram chat id (a number). The bot only answers this chat
# and ignores everyone else. See README "Step 3: Find your chat id".
BIRTHDAY_BOT_CHAT_ID=123456789

# Your timezone, in "Region/City" form. Reminders are sent in this timezone.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: Europe/London, America/New_York, Australia/Sydney
TZ=UTC

# ---------------------------------------------------------------- database --

# Database login used only between the containers. Pick any password; it
# never leaves your machine. Set it BEFORE the first start: it is saved
# into the database the first time the database is created.
POSTGRES_USER=birthday
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=birthday

# ----------------------------------------------------------------- web app --

# Port for the web app on your computer: http://localhost:8000
API_PORT=8000

# Who can open the web app. 127.0.0.1 = only this computer (safest).
# 0.0.0.0 = any device on your home Wi-Fi. The web app has NO password,
# so never expose it to the internet. See README.
API_BIND=127.0.0.1

# The web address the bot shows you when it says "add them in the web app".
# Change it if you open the web app from another device,
# e.g. http://<this-computer's-local-address>:8000
WEB_APP_URL=http://localhost:8000

# -------------------------------------------------------------- bot timing --

# What time (24-hour clock, in the TZ above) the bot sends daily reminders.
DAILY_CHECK_HOUR=9
DAILY_CHECK_MINUTE=0

# --------------------------------------------------------- optional extras --
# Leave these blank unless you want them. Blank = feature off, no errors.

# Healthchecks.io API key: emails you if the daily reminder stops running.
HEALTHCHECKS_API_KEY=

# Email reminders from the web app (in addition to Telegram). Set the
# recipient address in the web app's settings. Use your email provider's
# SMTP settings (many need an "app password" rather than your normal one).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Browser push notifications from the web app (advanced; browsers require
# HTTPS for this). Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=you@example.com
